# ================================================================
# ASHA Awaaz - Example Environment Configuration (.env.example)
# Safe template for version control. Copy to .env and fill in values:
# cp .env.example .env
# ================================================================

# Groq AI API Key (Optional)
# Get a free key at https://console.groq.com
# If left blank, the app runs 100% offline using the local deterministic engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Database Connection
# If MongoDB is not running, the backend seamlessly uses an in-memory database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=asha_awaaz

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Clinical Danger Sign Thresholds (Maternal & Child Protocol Rules)
DANGER_BP_SYSTOLIC=140
DANGER_BP_DIASTOLIC=90
DANGER_NEWBORN_TEMP_F=100.4

# Emergency Contacts
ANM_DEFAULT_PHONE=+91 98765 43210
PHC_HELPLINE=108
