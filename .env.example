# ASHA Awaaz Environment Configuration
# GROQ API Key (Optional - application runs out of the box with zero keys using the deterministic fallback engine)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Connection (Optional - defaults to resilient in-memory offline database if MongoDB is not running)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=asha_awaaz

# Authentication
JWT_SECRET=asha-awaaz-secret-key-build-for-bharat-2026
JWT_ALGORITHM=HS256

# Clinical Thresholds (Configurable Decision Support)
DANGER_BP_SYSTOLIC=140
DANGER_BP_DIASTOLIC=90
DANGER_NEWBORN_TEMP_F=100.4

# Emergency Contacts
ANM_DEFAULT_PHONE=+91 98765 43210
PHC_HELPLINE=108
